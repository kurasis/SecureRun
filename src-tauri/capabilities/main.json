{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the bundled main WebView can request scoped foundation operations.",
  "local": true,
  "webviews": ["main"],
  "permissions": [
    "allow-get-snapshot", "allow-create-draft", "allow-reserve-operation",
    "allow-select-file", "allow-prepare-transfer", "allow-get-operation",
    "allow-diagnostic-summary", "core:event:allow-listen", "core:event:allow-unlisten"
  ]
}
